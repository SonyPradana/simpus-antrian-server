# Salin ke .env lalu isi nilai untuk instalasi Anda.
# Jangan commit .env. File ini hanya contoh, semua nilai di bawah dummy.

# --- Server ---
APP_ADDR=:8080
APP_TIMEZONE=Asia/Jakarta
APP_USER_AGENT=simpus-antrian
HTTP_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s

# --- Database ---
# Pakai salah satu: DB_DSN, atau kombinasi DB_HOST/DB_USER/DB_NAME.
# DB_DSN=user:password@tcp(127.0.0.1:3306)/simpus?parseTime=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=simpus

# Lokasi config.json (opsional). Default: di samping executable.
CONFIG_FILE=

# --- Registrasi (wajib) ---
# Nilai ini spesifik per instalasi. Server menolak start kalau kosong.
WORKER_ID=1
POSCHECK_ID=1
ACTION_ID=1
CONSIGNOR_ID=1
GROUPVISIT_ID=1
JENIS_KUNJUNGAN_ID=1

# Label lokasi manual. Kosongkan agar diambil dari poschecks.nama.
LOCATION=

# --- BPJS / PCare ---
PCARE_BASE_URL=https://new-apijkn.bpjs-kesehatan.go.id/pcare-rest
# off | warn | strict
PCARE_MODE=warn
# Kode aplikasi dari BPJS. Wajib kalau PCare aktif.
PCARE_KODE_APLIKASI=
PCARE_CACHE_TTL=10m

# --- APM facade ---
# Wajib. /api/v1/apm/* menolak request tanpa header x-api-key.
APM_API_KEY=ubah-key-ini

# Origin browser yang diizinkan (opsional). Kosong = header CORS tidak dikirim.
# CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Operasional ---
ALLOW_OVERQUOTA=false
